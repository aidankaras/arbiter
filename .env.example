# Copy to .env and fill in. Never commit .env.

# --- Required identification for SEC EDGAR ---
# SEC requires a descriptive User-Agent with contact information on every request.
# Requests without one are rate-limited or blocked.
# Exactly two whitespace-separated parts: an identifier, then a contact email.
# A multi-word name is rejected at startup, so use a hyphenated identifier.
SEC_USER_AGENT="your-project-name your-email@example.com"

# --- Database ---
# Local development uses the docker-compose Postgres service.
# Scheduled jobs use a hosted Postgres instance with the pgvector extension.
DATABASE_URL="postgresql+psycopg://arbiter:arbiter@localhost:5432/arbiter"

# --- Model providers ---
# Bulk extraction runs through the Anthropic API (batch + prompt caching).
ANTHROPIC_API_KEY=""
# The arbiter arm uses a different model family to decorrelate judge errors.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# --- Broker (paper trading only) ---
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"

# --- Spend controls ---
# Hard ceilings enforced in code. The pipeline halts when either is crossed.
DAILY_SPEND_CEILING_USD="4.00"
PER_RUN_TOKEN_CEILING="250000"

# --- Runtime ---
ENVIRONMENT="development"
LOG_LEVEL="INFO"
